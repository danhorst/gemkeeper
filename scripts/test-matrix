#!/usr/bin/env bash
set -euo pipefail

# Ruby versions matching the CI matrix and gemspec constraint (>= 3.1.0)
VERSIONS=("3.1" "3.2" "3.3" "3.4")

PASS=()
FAIL=()
SKIP=()

for version in "${VERSIONS[@]}"; do
  echo ""
  echo "=== Ruby $version ==="

  if ! mise exec ruby@"$version" -- ruby --version > /dev/null 2>&1; then
    echo "  Not installed. Run: mise install ruby@$version"
    SKIP+=("$version")
    continue
  fi

  # bundle install re-resolves for each Ruby version, which may downgrade gems
  # (e.g. rubycritic to 0.0.16 on < 3.2). The restore step at the end fixes this.
  mise exec ruby@"$version" -- bundle install --quiet

  if mise exec ruby@"$version" -- bundle exec rake rubocop test; then
    PASS+=("$version")
  else
    FAIL+=("$version")
  fi
done

# Restore Gemfile.lock for the current Ruby after per-version installs may have downgraded gems.
echo ""
echo "=== Restoring current environment ==="
bundle install --quiet
bundle update rubycritic --quiet 2>/dev/null || true

echo ""
echo "=== Results ==="
[ ${#PASS[@]}  -gt 0 ] && echo "  pass: ${PASS[*]}"
[ ${#FAIL[@]}  -gt 0 ] && echo "  FAIL: ${FAIL[*]}"
[ ${#SKIP[@]}  -gt 0 ] && echo "  skip: ${SKIP[*]} (not installed)"

[ ${#FAIL[@]} -eq 0 ]
